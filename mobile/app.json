{
  "expo": {
    "name": "Milk Before Meat",
    "slug": "mbm",
    "version": "1.1.0",
    "orientation": "portrait",
    "updates": {
      "url": "https://u.expo.dev/6cc829be-50dd-4ae1-8122-34edbb379bbd",
      "fallbackToCacheTimeout": 0
    },
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#0a0a0f"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "org.milkb4meat.app",
      "infoPlist": {
        "CFBundleDisplayName": "Milk B4 Meat",
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0a0a0f"
      },
      "package": "com.milk_before_meat"
    },
    "web": {
      "bundler": "metro"
    },
    "plugins": [
      "expo-secure-store",
      [
        "expo-sqlite",
        {
          "enableFTS": true
        }
      ],
      "./plugins/withShortAppName.js",
      "./plugins/withAdiRegistration.js",
      "expo-video"
    ],
    "owner": "milkb4meat",
    "extra": {
      "eas": {
        "projectId": "6cc829be-50dd-4ae1-8122-34edbb379bbd"
      }
    }
  }
}
