[{"text": "Like him.", "start": 0.0, "end": 0.778}, {"text": "That was the point in the council \u2014 children, growing up into what their Father is.", "start": 0.778, "end": 6.281}, {"text": "The devil called that blasphemy.", "start": 6.281, "end": 8.429}, {"text": "The Father calls it parenthood.", "start": 8.429, "end": 10.681}]