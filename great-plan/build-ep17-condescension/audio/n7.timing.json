[{"text": "It did not work.", "start": 0.0, "end": 1.126}, {"text": "It never works.", "start": 1.126, "end": 2.299}, {"text": "Joseph was warned in a dream and carried the child to Egypt.", "start": 2.299, "end": 5.909}, {"text": "The believers held through the bright night.", "start": 5.909, "end": 8.336}, {"text": "The cradle outlived both attacks.", "start": 8.336, "end": 10.913}]