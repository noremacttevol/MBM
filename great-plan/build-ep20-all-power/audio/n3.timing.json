[{"text": "Risen.", "start": 0.0, "end": 0.627}, {"text": "Not resuscitated.", "start": 0.627, "end": 2.101}, {"text": "Not remembered.", "start": 2.101, "end": 3.181}, {"text": "Risen \u2014 body and spirit reunited forever, death running backward.", "start": 3.181, "end": 7.941}, {"text": "Thomas touched the marks.", "start": 7.941, "end": 9.718}, {"text": "For forty days, hundreds watched him eat, and walk, and teach.", "start": 9.718, "end": 13.978}]