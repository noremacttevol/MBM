[{"text": "So read the scoreboard.", "start": 0.0, "end": 1.184}, {"text": "The tomb is empty.", "start": 1.184, "end": 2.531}, {"text": "Death is temporary.", "start": 2.531, "end": 4.087}, {"text": "Both hemispheres hold apostles with keys.", "start": 4.087, "end": 7.036}, {"text": "The devil's checkmate piece is off the board forever \u2014 so watch him closely now.", "start": 7.036, "end": 11.877}, {"text": "He is about to change strategies.", "start": 11.877, "end": 13.978}, {"text": "Next: the long theft.", "start": 13.978, "end": 16.579}]