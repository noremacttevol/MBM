[{"text": "Now the hard question.", "start": 0.0, "end": 1.149}, {"text": "If God is all-powerful, and all-good \u2014 why keep a devil around?", "start": 1.149, "end": 5.259}, {"text": "Why not just turn him off?", "start": 5.259, "end": 7.036}, {"text": "God answered that question directly.", "start": 7.036, "end": 9.857}, {"text": "Listen:", "start": 9.88, "end": 10.588}]