[{"text": "Lucifer.", "start": 0.0, "end": 0.952}, {"text": "The name means light-bearer.", "start": 0.952, "end": 2.937}, {"text": "Son of the morning.", "start": 2.937, "end": 4.609}, {"text": "This was not some monster crawling out of a pit \u2014 this was one of the family.", "start": 4.609, "end": 9.532}, {"text": "Brilliant.", "start": 9.532, "end": 10.635}, {"text": "Trusted.", "start": 10.635, "end": 11.61}, {"text": "Standing in authority.", "start": 11.61, "end": 13.166}, {"text": "Until he wanted the throne more than the family.", "start": 13.166, "end": 16.068}]