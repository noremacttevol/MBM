[{"text": "Lucifer.", "start": 0.0, "end": 0.592}, {"text": "The name means light-bearer.", "start": 0.592, "end": 2.043}, {"text": "Son of the morning.", "start": 2.043, "end": 3.344}, {"text": "Not a monster from a pit \u2014 one of the family.", "start": 3.344, "end": 6.327}, {"text": "Brilliant.", "start": 6.327, "end": 7.21}, {"text": "Trusted.", "start": 7.21, "end": 8.255}, {"text": "Until he wanted the throne more than the family.", "start": 8.255, "end": 10.867}]