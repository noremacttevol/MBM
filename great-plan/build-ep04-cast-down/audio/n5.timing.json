[{"text": "That is his entire business model, in one line.", "start": 0.0, "end": 2.914}, {"text": "He cannot win anything anymore.", "start": 2.914, "end": 5.085}, {"text": "No body.", "start": 5.085, "end": 6.327}, {"text": "No future.", "start": 6.327, "end": 7.291}, {"text": "No throne.", "start": 7.291, "end": 8.44}, {"text": "So he plays for one outcome only \u2014 making your loss as total as his.", "start": 8.44, "end": 14.257}]