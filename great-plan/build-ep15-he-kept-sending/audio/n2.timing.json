[{"text": "After Moses, Israel settled the promised land \u2014 and started a cycle.", "start": 0.0, "end": 4.18}, {"text": "Forget God.", "start": 4.18, "end": 5.492}, {"text": "Fall apart.", "start": 5.492, "end": 6.42}, {"text": "Cry out.", "start": 6.42, "end": 7.477}, {"text": "Be rescued.", "start": 7.477, "end": 8.44}, {"text": "And forget again.", "start": 8.44, "end": 9.706}, {"text": "For centuries.", "start": 9.706, "end": 11.238}]