[{"text": "No joy \u2014 because no misery.", "start": 0.0, "end": 2.148}, {"text": "No good \u2014 because no sin.", "start": 2.148, "end": 4.702}, {"text": "Frozen.", "start": 4.702, "end": 6.188}, {"text": "Eden was beautiful the way a photograph is beautiful.", "start": 6.188, "end": 9.358}, {"text": "Perfect, and going nowhere.", "start": 9.358, "end": 11.981}]