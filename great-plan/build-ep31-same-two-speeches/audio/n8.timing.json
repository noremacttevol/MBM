[{"text": "Persuasion.", "start": 0.0, "end": 0.964}, {"text": "Long-suffering.", "start": 0.964, "end": 2.09}, {"text": "Gentleness.", "start": 2.09, "end": 3.042}, {"text": "Love unfeigned.", "start": 3.042, "end": 4.284}, {"text": "That is the signature of heaven.", "start": 4.284, "end": 6.107}, {"text": "So when any voice pushes, panics, shames, or forces you \u2014 check the return address.", "start": 6.107, "end": 12.817}]