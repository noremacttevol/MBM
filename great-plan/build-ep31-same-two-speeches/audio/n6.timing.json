[{"text": "Carefully.", "start": 0.0, "end": 0.778}, {"text": "Not dramatically \u2014 carefully.", "start": 0.778, "end": 3.077}, {"text": "No horns.", "start": 3.077, "end": 4.063}, {"text": "No contracts at midnight.", "start": 4.063, "end": 6.049}, {"text": "Just comfort, a closed curtain, and one degree of drift a day.", "start": 6.049, "end": 10.635}]