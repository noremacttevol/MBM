[{"text": "Carefully.", "start": 0.0, "end": 0.697}, {"text": "Not dramatically \u2014 carefully.", "start": 0.697, "end": 2.833}, {"text": "No horns.", "start": 2.833, "end": 4.133}, {"text": "No contracts at midnight crossroads.", "start": 4.133, "end": 6.769}, {"text": "Just comfort, a closed curtain, and one degree of drift a day.", "start": 6.769, "end": 11.331}]