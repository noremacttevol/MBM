[{"text": "You have watched this war from before the world to the restored kingdom.", "start": 0.0, "end": 3.158}, {"text": "Three episodes left.", "start": 3.158, "end": 4.656}, {"text": "First: where is the war right now?", "start": 4.656, "end": 6.513}, {"text": "Answer \u2014 in your pocket.", "start": 6.513, "end": 9.033}, {"text": "In your feed.", "start": 9.033, "end": 10.019}, {"text": "In your head.", "start": 10.019, "end": 11.204}, {"text": "Same two speeches.", "start": 11.204, "end": 12.69}, {"text": "Modern clothes.", "start": 12.69, "end": 14.071}]