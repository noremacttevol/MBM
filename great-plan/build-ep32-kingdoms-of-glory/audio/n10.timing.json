[{"text": "Add up the ending.", "start": 0.0, "end": 1.219}, {"text": "Every child, safe.", "start": 1.219, "end": 3.506}, {"text": "Every never-reached soul, reached.", "start": 3.506, "end": 6.362}, {"text": "Resurrection, free, for all.", "start": 6.362, "end": 9.033}, {"text": "Kingdoms, not a furnace.", "start": 9.033, "end": 11.099}, {"text": "Now say the article of faith with me:", "start": 11.54, "end": 13.932}]