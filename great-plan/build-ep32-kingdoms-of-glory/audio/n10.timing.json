[{"text": "So add up the ending.", "start": 0.0, "end": 1.126}, {"text": "Every child, safe.", "start": 1.126, "end": 2.519}, {"text": "Every never-reached soul, reached.", "start": 2.519, "end": 4.69}, {"text": "Resurrection, free, for all.", "start": 4.69, "end": 7.163}, {"text": "Kingdoms, instead of a furnace.", "start": 7.163, "end": 9.16}, {"text": "The family of Adam losing as close to nobody as agency allows.", "start": 9.16, "end": 12.864}, {"text": "Now say the article of faith with me:", "start": 13.305, "end": 15.232}]