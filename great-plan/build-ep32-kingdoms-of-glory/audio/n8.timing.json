[{"text": "Celestial.", "start": 0.0, "end": 0.813}, {"text": "Terrestrial.", "start": 0.813, "end": 2.043}, {"text": "Telestial.", "start": 2.043, "end": 3.077}, {"text": "Sun, moon, and stars \u2014 and even the least is a glory that surpasses all understanding.", "start": 3.077, "end": 9.776}, {"text": "The Father does not run an incinerator.", "start": 9.776, "end": 12.469}, {"text": "He runs a homecoming.", "start": 12.469, "end": 14.025}]