[{"text": "Celestial.", "start": 0.0, "end": 0.708}, {"text": "Terrestrial.", "start": 0.708, "end": 1.474}, {"text": "Tuh LESS chul.", "start": 1.474, "end": 2.949}, {"text": "Sun, moon, and stars \u2014 and even the least is a glory that surpasses all understanding.", "start": 2.949, "end": 8.359}, {"text": "The Father does not run an incinerator.", "start": 8.359, "end": 10.786}, {"text": "He runs a homecoming.", "start": 10.786, "end": 12.399}]