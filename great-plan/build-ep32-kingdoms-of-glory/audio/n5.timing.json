[{"text": "All children.", "start": 0.0, "end": 0.789}, {"text": "Highest heaven.", "start": 0.789, "end": 1.625}, {"text": "No exceptions.", "start": 1.625, "end": 2.717}, {"text": "If you have lost a little one \u2014 that is where they are.", "start": 2.717, "end": 6.095}, {"text": "And that is who God is.", "start": 6.095, "end": 7.941}]