[{"text": "Reformers rose.", "start": 0.0, "end": 1.242}, {"text": "Luther, nailing his protest to a church door.", "start": 1.242, "end": 4.296}, {"text": "Calvin.", "start": 4.296, "end": 5.387}, {"text": "Wesley, preaching in open fields.", "start": 5.387, "end": 8.15}, {"text": "Good men.", "start": 8.15, "end": 9.706}, {"text": "Brave men.", "start": 9.706, "end": 10.983}, {"text": "They saw that something was deeply wrong, and they fought it with everything they had.", "start": 10.983, "end": 16.858}]