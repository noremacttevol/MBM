[{"text": "A welding together of dispensations, keys, powers, and glories.", "start": 0.0, "end": 4.481}, {"text": "Adam's gospel.", "start": 4.481, "end": 6.165}, {"text": "Enoch's Zion.", "start": 6.165, "end": 7.558}, {"text": "Abraham's covenant.", "start": 7.558, "end": 9.044}, {"text": "Moses' gathering.", "start": 9.044, "end": 10.612}, {"text": "The apostles' keys.", "start": 10.612, "end": 12.272}, {"text": "Elijah's sealing.", "start": 12.272, "end": 13.642}, {"text": "All of it \u2014 one kingdom, one last time, never to be lost again.", "start": 13.642, "end": 19.087}]