[{"text": "Never destroyed.", "start": 0.0, "end": 0.975}, {"text": "Never left to other people.", "start": 0.975, "end": 2.368}, {"text": "The old pattern \u2014 given, stolen, wait \u2014 is over.", "start": 2.368, "end": 6.85}, {"text": "That is the whole point of the fulness of times.", "start": 6.85, "end": 9.509}, {"text": "Last means last.", "start": 9.509, "end": 11.424}]