[{"text": "Outside Eden the ground fought them.", "start": 0.0, "end": 2.009}, {"text": "Thorns.", "start": 2.009, "end": 2.972}, {"text": "Sweat.", "start": 2.972, "end": 3.587}, {"text": "Loss.", "start": 3.587, "end": 4.551}, {"text": "And also \u2014 for the first time \u2014 children.", "start": 4.551, "end": 8.057}, {"text": "Morning laughter.", "start": 8.057, "end": 9.276}, {"text": "Work worth doing.", "start": 9.276, "end": 10.67}, {"text": "Choices that actually meant something.", "start": 10.67, "end": 12.957}]