[{"text": "Face to face.", "start": 0.0, "end": 1.01}, {"text": "As a man speaks to his friend.", "start": 1.01, "end": 2.67}, {"text": "Not a force.", "start": 2.67, "end": 3.855}, {"text": "Not an abstraction.", "start": 3.855, "end": 5.457}, {"text": "A Person \u2014 knowable, present, and shockingly personal.", "start": 5.457, "end": 10.17}]