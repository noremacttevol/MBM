[{"text": "Enoch.", "start": 0.0, "end": 0.592}, {"text": "Seventh from Adam.", "start": 0.592, "end": 2.218}, {"text": "A slow-of-speech young man God called to preach to a world sliding into violence.", "start": 2.218, "end": 7.245}, {"text": "And against everything, people listened.", "start": 7.245, "end": 10.124}]