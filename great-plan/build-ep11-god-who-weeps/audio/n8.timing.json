[{"text": "Laughing.", "start": 0.0, "end": 0.685}, {"text": "At human misery.", "start": 0.685, "end": 2.252}, {"text": "That is who he is when nobody dresses him up.", "start": 2.252, "end": 5.352}, {"text": "Not a gentleman negotiator.", "start": 5.352, "end": 7.245}, {"text": "Not a misunderstood rebel.", "start": 7.245, "end": 9.044}, {"text": "A jailer \u2014 delighted by the chain.", "start": 9.044, "end": 11.703}]