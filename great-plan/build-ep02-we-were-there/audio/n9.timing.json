[{"text": "The devil needs you to forget every word of this.", "start": 0.0, "end": 2.705}, {"text": "You're worthless.", "start": 2.705, "end": 3.866}, {"text": "You're an animal.", "start": 3.866, "end": 5.039}, {"text": "You're alone.", "start": 5.039, "end": 6.095}, {"text": "You're an accident.", "start": 6.095, "end": 7.465}, {"text": "Every one of those lies is aimed at a single target: your memory of who you are.", "start": 7.465, "end": 12.957}]