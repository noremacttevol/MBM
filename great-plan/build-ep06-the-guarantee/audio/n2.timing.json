[{"text": "Start with the forgetting.", "start": 0.0, "end": 1.347}, {"text": "A veil was drawn across your memory \u2014 heaven, the council, His face.", "start": 1.347, "end": 6.385}, {"text": "Not as a punishment.", "start": 6.385, "end": 8.057}, {"text": "As the whole point.", "start": 8.057, "end": 9.752}]