[{"text": "Other sheep.", "start": 0.0, "end": 0.731}, {"text": "That was never a metaphor.", "start": 0.731, "end": 2.218}, {"text": "It was an address.", "start": 2.218, "end": 3.46}, {"text": "And after his resurrection, he kept that promise in person \u2014 but that is episode twenty.", "start": 3.46, "end": 8.684}]