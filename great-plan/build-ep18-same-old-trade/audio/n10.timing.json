[{"text": "Watch the whole pattern.", "start": 0.0, "end": 1.37}, {"text": "The devil's power grabs.", "start": 1.37, "end": 2.984}, {"text": "God's power gives.", "start": 2.984, "end": 4.365}, {"text": "The devil demands worship.", "start": 4.365, "end": 6.142}, {"text": "Jesus kneels and washes feet.", "start": 6.142, "end": 8.243}, {"text": "One voice still sells the shortcut.", "start": 8.243, "end": 10.588}, {"text": "The other still says follow me \u2014 and lets you walk away if you must.", "start": 10.588, "end": 15.279}]