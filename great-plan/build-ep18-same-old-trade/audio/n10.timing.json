[{"text": "Watch the pattern.", "start": 0.0, "end": 0.929}, {"text": "The devil's power grabs.", "start": 0.929, "end": 2.81}, {"text": "God's power gives.", "start": 2.81, "end": 4.122}, {"text": "One voice still sells the shortcut.", "start": 4.122, "end": 6.339}, {"text": "The other still says follow me \u2014 and lets you walk away if you must.", "start": 6.339, "end": 10.495}]