[{"text": "Then He went and spent three years doing the opposite of the shortcut.", "start": 0.0, "end": 3.181}, {"text": "Touching lepers nobody would touch.", "start": 3.181, "end": 5.341}, {"text": "Feeding crowds.", "start": 5.341, "end": 6.513}, {"text": "Forgiving the unforgivable.", "start": 6.513, "end": 8.092}, {"text": "Power, spent downward \u2014 always downward.", "start": 8.092, "end": 11.564}]