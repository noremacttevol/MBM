[{"text": "He lifts it up, lays it across his own shoulders, and carries it the whole way home, rejoicing.", "start": 0.05, "end": 7.499999799999999}, {"text": "Not relieved.", "start": 7.4999998, "end": 8.8281247}, {"text": "Not annoyed at the trouble.", "start": 8.8281248, "end": 10.7187497}, {"text": "Rejoicing.", "start": 10.7187498, "end": 11.8906247}]