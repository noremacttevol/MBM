[{"text": "He lifts it up, lays it across his own shoulders, and carries it the whole way home, rejoicing.", "start": 0.05, "end": 7.692307899999999}, {"text": "Not relieved.", "start": 7.6923079, "end": 9.054487400000001}, {"text": "Not annoyed at the trouble.", "start": 9.0544875, "end": 10.9935901}, {"text": "Rejoicing.", "start": 10.9935901, "end": 12.1955132}]