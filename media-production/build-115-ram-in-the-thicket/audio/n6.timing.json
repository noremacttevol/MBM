[{"text": "Stop.", "start": 0.05, "end": 0.9935897}, {"text": "God never wanted the child.", "start": 0.9935897, "end": 3.1730769}, {"text": "He never did.", "start": 3.173077, "end": 4.4391026}, {"text": "He stopped Abraham's hand, and right there, caught in a thicket, was a ram \u2014 God's own provision, ready all along.", "start": 4.4391027, "end": 14.487179900000001}, {"text": "The boy was safe.", "start": 14.48718, "end": 16.1538467}, {"text": "He was always going to be safe.", "start": 16.1538467, "end": 18.4294878}]