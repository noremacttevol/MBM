[{"text": "Who is he, sir?", "start": 0.0, "end": 0.894}, {"text": "Tell me, so I can believe in him.", "start": 0.894, "end": 3.007}, {"text": "He is not stalling.", "start": 3.007, "end": 4.493}, {"text": "He is asking for a name so he can give himself to it.", "start": 4.493, "end": 7.326}, {"text": "And Jesus said:", "start": 7.651, "end": 8.87}]