[{"text": "Who is he, sir?", "start": 0.0, "end": 0.99}, {"text": "Tell me, so I can believe in him.", "start": 0.99, "end": 3.167}, {"text": "He is not stalling.", "start": 3.167, "end": 4.421}, {"text": "He is asking for a name so he can give himself to it.", "start": 4.421, "end": 7.918}, {"text": "And Jesus said:", "start": 7.918, "end": 8.908}]