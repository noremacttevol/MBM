[{"text": "Who is he, sir?", "start": 0.05, "end": 1.3906249}, {"text": "Tell me, so I can believe in him.", "start": 1.3906249, "end": 4.0624998}, {"text": "He is not stalling.", "start": 4.0624999, "end": 5.609374799999999}, {"text": "He is asking for a name so he can give himself to it.", "start": 5.6093749, "end": 9.3124998}, {"text": "And Jesus said:", "start": 9.3124998, "end": 10.8124997}]