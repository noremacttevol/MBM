[{"text": "Why are you crying?", "start": 0.05, "end": 1.4374999}, {"text": "he asked her.", "start": 1.4374999, "end": 2.7187498}, {"text": "Who is it you're looking for?", "start": 2.7187499, "end": 4.4999998}, {"text": "She did not know the voice yet.", "start": 4.4999999, "end": 6.687499799999999}, {"text": "Through the tears, she could not even see his face.", "start": 6.6874999, "end": 10.5781248}]