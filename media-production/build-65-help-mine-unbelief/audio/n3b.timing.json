[{"text": "Lord, I believe, he said.", "start": 0.05, "end": 2.1718748999999997}, {"text": "Help me where I don't.", "start": 2.1718749, "end": 3.7812498000000003}, {"text": "He did not hand Jesus a finished faith.", "start": 3.7812499, "end": 6.7656248}, {"text": "He handed him a cracked one, and asked him to hold it anyway.", "start": 6.7656248, "end": 10.9999997}]