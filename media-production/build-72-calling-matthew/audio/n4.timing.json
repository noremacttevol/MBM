[{"text": "Two words.", "start": 0.05, "end": 1.2980769}, {"text": "And notice what is missing from them.", "start": 1.2980769, "end": 3.4775641000000004}, {"text": "No pay it all back first.", "start": 3.4775642, "end": 5.5608976000000006}, {"text": "No prove you have changed.", "start": 5.5608976, "end": 7.5000002}, {"text": "No list of conditions to clear before he was allowed to come.", "start": 7.5000002, "end": 11.891026}, {"text": "Just, come.", "start": 11.891026, "end": 13.108974700000001}]