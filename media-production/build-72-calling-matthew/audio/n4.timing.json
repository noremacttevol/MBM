[{"text": "Two words.", "start": 0.05, "end": 1.2656249}, {"text": "And notice what is missing from them.", "start": 1.2656249, "end": 3.3906248000000003}, {"text": "No pay it all back first.", "start": 3.3906249, "end": 5.4218748}, {"text": "No prove you have changed.", "start": 5.4218749, "end": 7.312499799999999}, {"text": "No list of conditions to clear before he was allowed to come.", "start": 7.3124998, "end": 11.5937497}, {"text": "Just, come.", "start": 11.5937498, "end": 12.7812497}]