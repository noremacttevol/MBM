[{"text": "She heard Jesus was nearby.", "start": 0.0, "end": 1.823}, {"text": "She did not ask permission.", "start": 1.823, "end": 3.529}, {"text": "She did not make a speech.", "start": 3.529, "end": 5.19}, {"text": "She said only one thing, and she said it to herself.", "start": 5.19, "end": 8.545}]