[{"text": "That old word suffer just means let.", "start": 0.05, "end": 2.6718748999999997}, {"text": "Let them come.", "start": 2.6718749, "end": 3.9374998000000003}, {"text": "Don't stand in their way.", "start": 3.9374999, "end": 5.6562498}, {"text": "Then he went further.", "start": 5.6562499, "end": 7.203124799999999}]