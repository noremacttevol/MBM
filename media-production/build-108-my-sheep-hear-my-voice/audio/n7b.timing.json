[{"text": "That is the shepherd he is.", "start": 0.0, "end": 2.278}, {"text": "Led, not driven.", "start": 2.278, "end": 3.628}, {"text": "Known, not counted.", "start": 3.628, "end": 5.232}, {"text": "Held, and never let go.", "start": 5.232, "end": 7.173}, {"text": "And even now he is calling, gently, past the flock, to whoever is still outside.", "start": 7.173, "end": 13.923}]