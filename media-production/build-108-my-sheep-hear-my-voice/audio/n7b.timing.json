[{"text": "That is the shepherd he is.", "start": 0.05, "end": 1.9687499}, {"text": "Led, not driven.", "start": 1.9687499, "end": 3.8281248}, {"text": "Known, not counted.", "start": 3.8281249, "end": 5.8124998}, {"text": "Held, and never let go.", "start": 5.8124999, "end": 7.984374799999999}, {"text": "And even now he is calling, gently, past the flock, to whoever is still outside.", "start": 7.9843748, "end": 15.0937496}]