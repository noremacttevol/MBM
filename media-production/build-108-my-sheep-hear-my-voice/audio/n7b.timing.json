[{"text": "That is the shepherd he is.", "start": 0.05, "end": 2.0723683999999998}, {"text": "Led, not driven.", "start": 2.0723684, "end": 4.029605200000001}, {"text": "Known, not counted.", "start": 4.0296053, "end": 6.1184211}, {"text": "Held, and never let go.", "start": 6.1184211, "end": 8.4046053}, {"text": "And even now he is calling, gently, past the flock, to whoever is still outside.", "start": 8.4046053, "end": 15.888158}]