[{"text": "That is the shepherd he is.", "start": 0.0, "end": 1.637}, {"text": "Led, not driven.", "start": 1.637, "end": 3.471}, {"text": "Known, not counted.", "start": 3.471, "end": 5.596}, {"text": "Held, and never let go.", "start": 5.596, "end": 7.593}, {"text": "And even now he is calling, gently, past the flock, to whoever is still outside.", "start": 7.593, "end": 13.886}]