[{"text": "Why did you doubt?", "start": 0.05, "end": 1.3124999}, {"text": "Hear how he asked it.", "start": 1.3124999, "end": 2.9218748}, {"text": "Not from the shore.", "start": 2.9218749, "end": 4.3906248}, {"text": "Not after pulling him into the boat.", "start": 4.3906249, "end": 6.859374799999999}, {"text": "From the hand already holding him.", "start": 6.8593748, "end": 9.5624997}, {"text": "It isn't a scolding.", "start": 9.5624998, "end": 11.0937497}, {"text": "It's a real question, from someone who had already caught him \u2014 as if to say: you were doing it.", "start": 11.0937498, "end": 18.4374996}, {"text": "What made you stop trusting me?", "start": 18.4374997, "end": 20.5312496}]