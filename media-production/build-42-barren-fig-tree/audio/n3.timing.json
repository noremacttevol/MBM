[{"text": "So the owner came out to pick a few, the way you would.", "start": 0.05, "end": 3.6249998999999997}, {"text": "And there was nothing on it.", "start": 3.6249999, "end": 5.2968748}, {"text": "Not a small crop.", "start": 5.2968749, "end": 6.765624799999999}, {"text": "Not a late one.", "start": 6.7656248, "end": 8.0312497}, {"text": "Bare leaves, and no fruit at all.", "start": 8.0312498, "end": 10.6718747}]