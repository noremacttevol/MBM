[{"text": "So the man outside does the thing nobody expected.", "start": 0.05, "end": 3.6093748999999997}, {"text": "He knocks again.", "start": 3.6093749, "end": 4.9374998}, {"text": "Louder.", "start": 4.9374999, "end": 5.953124799999999}, {"text": "Shutters bang open up the street.", "start": 5.9531249, "end": 8.7031248}, {"text": "Dogs start barking.", "start": 8.7031248, "end": 10.3437497}, {"text": "And he keeps knocking.", "start": 10.3437498, "end": 11.9218747}]