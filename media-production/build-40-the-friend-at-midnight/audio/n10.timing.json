[{"text": "So the man outside does the thing nobody expected.", "start": 0.0, "end": 3.279}, {"text": "He knocks again.", "start": 3.279, "end": 4.328}, {"text": "Louder.", "start": 4.328, "end": 4.787}, {"text": "Shutters bang open up the street.", "start": 4.787, "end": 6.951}, {"text": "Dogs start barking.", "start": 6.951, "end": 8.197}, {"text": "And he keeps knocking.", "start": 8.197, "end": 9.639}]