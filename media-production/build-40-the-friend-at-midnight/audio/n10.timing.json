[{"text": "So the man outside does the thing nobody expected.", "start": 0.0, "end": 2.752}, {"text": "He knocks again.", "start": 2.752, "end": 4.029}, {"text": "Louder.", "start": 4.029, "end": 4.981}, {"text": "Shutters bang open up the street.", "start": 4.981, "end": 6.989}, {"text": "Dogs start barking.", "start": 6.989, "end": 8.475}, {"text": "And he keeps knocking.", "start": 8.475, "end": 10.17}]