[{"text": "So the man outside does the thing nobody expected.", "start": 0.0, "end": 2.287}, {"text": "He knocks again.", "start": 2.287, "end": 3.738}, {"text": "Louder.", "start": 3.738, "end": 4.54}, {"text": "Shutters bang open up the street.", "start": 4.54, "end": 6.513}, {"text": "Dogs start barking.", "start": 6.513, "end": 8.162}, {"text": "And he keeps knocking.", "start": 8.162, "end": 9.845}]