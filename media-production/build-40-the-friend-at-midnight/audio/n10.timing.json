[{"text": "So the man outside does the thing nobody expected.", "start": 0.05, "end": 3.7019232}, {"text": "He knocks again.", "start": 3.7019232, "end": 5.0641027}, {"text": "Louder.", "start": 5.0641027, "end": 6.1057694}, {"text": "Shutters bang open up the street.", "start": 6.1057694, "end": 8.9262823}, {"text": "Dogs start barking.", "start": 8.9262823, "end": 10.6089746}, {"text": "And he keeps knocking.", "start": 10.6089747, "end": 12.2275645}]