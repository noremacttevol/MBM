[{"text": "Lord, remember me when you come into your kingdom.", "start": 0.05, "end": 3.9531248999999997}, {"text": "No good deeds to offer.", "start": 3.9531249, "end": 6.0468748}, {"text": "No time left to fix his life.", "start": 6.0468749, "end": 8.4062498}, {"text": "Just a dying man asking.", "start": 8.4062498, "end": 10.4531247}]