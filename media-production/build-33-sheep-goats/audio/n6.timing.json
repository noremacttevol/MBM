[{"text": "They were not keeping score.", "start": 0.05, "end": 1.7968749}, {"text": "They were not trying to earn anything.", "start": 1.7968749, "end": 4.0624998}, {"text": "Kindness was simply their reflex.", "start": 4.0624999, "end": 6.656249799999999}, {"text": "And then the King tells them the secret behind all of it.", "start": 6.6562499, "end": 10.3281248}]