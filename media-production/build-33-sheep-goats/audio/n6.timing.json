[{"text": "They were not keeping score.", "start": 0.05, "end": 1.8429487}, {"text": "They were not trying to earn anything.", "start": 1.8429487, "end": 4.1666667}, {"text": "Kindness was simply their reflex.", "start": 4.1666668, "end": 6.8269233}, {"text": "And then the King tells them the secret behind all of it.", "start": 6.8269233, "end": 10.592949}]