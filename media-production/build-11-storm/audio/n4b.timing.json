[{"text": "Don't you care that we are going down?", "start": 0.0, "end": 1.974}, {"text": "Listen to what they were really saying.", "start": 1.974, "end": 4.168}, {"text": "They never doubted his power.", "start": 4.168, "end": 5.863}, {"text": "They doubted his heart.", "start": 5.863, "end": 7.709}]