[{"text": "Don't you care that we are going down?", "start": 0.0, "end": 2.043}, {"text": "Listen to what they were really saying.", "start": 2.043, "end": 4.412}, {"text": "They never doubted his power.", "start": 4.412, "end": 6.455}, {"text": "They doubted his heart.", "start": 6.455, "end": 8.359}]