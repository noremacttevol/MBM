[{"text": "Don't you care that we are going down?", "start": 0.05, "end": 2.2499998999999997}, {"text": "Listen to what they were really saying.", "start": 2.2499999, "end": 4.5156248}, {"text": "They never doubted his power.", "start": 4.5156249, "end": 6.656249799999999}, {"text": "They doubted his heart.", "start": 6.6562499, "end": 8.3749998}]