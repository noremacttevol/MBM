[{"text": "Notice what did not happen.", "start": 0.05, "end": 1.8269231000000001}, {"text": "She did not push through a crowd.", "start": 1.8269231, "end": 4.0865385}, {"text": "She did not call out to him.", "start": 4.0865386, "end": 5.9775643}, {"text": "She did not ask.", "start": 5.9775643, "end": 7.5801283999999995}, {"text": "He called her first.", "start": 7.5801284, "end": 9.294872}, {"text": "Before she said one word, he had already decided.", "start": 9.2948721, "end": 13.1730773}]