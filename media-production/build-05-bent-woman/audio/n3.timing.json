[{"text": "Notice what did not happen.", "start": 0.0, "end": 1.718}, {"text": "She did not push through a crowd.", "start": 1.718, "end": 3.611}, {"text": "She did not call out to him.", "start": 3.611, "end": 5.631}, {"text": "She did not ask.", "start": 5.631, "end": 6.989}, {"text": "He called her first.", "start": 6.989, "end": 8.382}, {"text": "Before she said one word, he had already decided.", "start": 8.382, "end": 11.656}]