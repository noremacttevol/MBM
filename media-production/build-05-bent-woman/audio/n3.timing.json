[{"text": "Notice what did not happen.", "start": 0.05, "end": 1.7812499}, {"text": "She did not push through a crowd.", "start": 1.7812499, "end": 3.9843748000000003}, {"text": "She did not call out to him.", "start": 3.9843749, "end": 5.8281248}, {"text": "She did not ask.", "start": 5.8281249, "end": 7.390624799999999}, {"text": "He called her first.", "start": 7.3906248, "end": 9.0624997}, {"text": "Before she said one word, he had already decided.", "start": 9.0624998, "end": 12.8437497}]