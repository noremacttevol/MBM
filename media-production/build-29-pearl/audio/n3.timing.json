[{"text": "He had seen a lot of beautiful pearls.", "start": 0.05, "end": 2.8365384999999996}, {"text": "Good ones.", "start": 2.8365385, "end": 4.0544872000000005}, {"text": "Costly ones.", "start": 4.0544873, "end": 5.496795}, {"text": "But he kept looking, because not one of them was the one.", "start": 5.496795, "end": 9.375000199999999}]