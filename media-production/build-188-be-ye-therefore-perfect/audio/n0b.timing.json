[{"text": "Love your enemies, he said.", "start": 0.05, "end": 2.2499998999999997}, {"text": "Bless the ones who curse you.", "start": 2.2499999, "end": 4.3906248}, {"text": "Do good to the ones who hate you, and pray for the people who use you badly.", "start": 4.3906249, "end": 9.8281248}, {"text": "Not put up with them.", "start": 9.8281248, "end": 11.2656247}, {"text": "Not stay out of their way.", "start": 11.2656248, "end": 12.9062497}, {"text": "Love them, and mean it.", "start": 12.9062498, "end": 14.7343747}]