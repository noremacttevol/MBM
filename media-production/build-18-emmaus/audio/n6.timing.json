[{"text": "They sat down to the table.", "start": 0.05, "end": 1.9531249}, {"text": "And then their guest did the one thing only the host of the house should do.", "start": 1.9531249, "end": 6.687499799999999}, {"text": "He took the bread.", "start": 6.6874999, "end": 8.0312498}, {"text": "He blessed it.", "start": 8.0312498, "end": 9.2499997}, {"text": "He broke it.", "start": 9.2499998, "end": 10.4531247}, {"text": "And he held it out to them.", "start": 10.4531248, "end": 12.1406247}]