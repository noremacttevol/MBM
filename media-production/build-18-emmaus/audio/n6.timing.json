[{"text": "They sat down to the table.", "start": 0.05, "end": 2.0032052}, {"text": "And then their guest did the one thing only the host of the house should do.", "start": 2.0032052, "end": 6.8589746}, {"text": "He took the bread.", "start": 6.8589746, "end": 8.2371797}, {"text": "He blessed it.", "start": 8.2371797, "end": 9.4871797}, {"text": "He broke it.", "start": 9.4871798, "end": 10.721154199999999}, {"text": "And he held it out to them.", "start": 10.7211542, "end": 12.4519234}]