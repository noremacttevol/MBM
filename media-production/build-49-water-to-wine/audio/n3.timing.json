[{"text": "And then, quietly, disaster.", "start": 0.05, "end": 2.9166667}, {"text": "The wine ran out.", "start": 2.9166667, "end": 4.5833334}, {"text": "To us that sounds small.", "start": 4.5833335, "end": 6.4583335}, {"text": "To that family it was a public shame they would carry for years.", "start": 6.4583335, "end": 11.3141029}, {"text": "The feast, and their good name, were about to collapse.", "start": 11.3141029, "end": 15.753205600000001}]