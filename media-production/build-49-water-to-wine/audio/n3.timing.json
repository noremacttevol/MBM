[{"text": "And then, quietly, disaster.", "start": 0.05, "end": 2.8437498999999997}, {"text": "The wine ran out.", "start": 2.8437499, "end": 4.4687498}, {"text": "To us that sounds small.", "start": 4.4687499, "end": 6.296874799999999}, {"text": "To that family it was a public shame they would carry for years.", "start": 6.2968749, "end": 11.0312498}, {"text": "The feast, and their good name, were about to collapse.", "start": 11.0312498, "end": 15.3593747}]