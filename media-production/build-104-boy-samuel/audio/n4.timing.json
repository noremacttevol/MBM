[{"text": "But Eli said, I did not call you.", "start": 0.05, "end": 2.7656248999999997}, {"text": "Go back and lie down.", "start": 2.7656249, "end": 4.4843748}, {"text": "So he did.", "start": 4.4843749, "end": 5.671874799999999}, {"text": "And the voice came again \u2014 Samuel \u2014 and again he ran to the old man, and again Eli sent him back.", "start": 5.6718749, "end": 13.8593747}, {"text": "It happened a third time.", "start": 13.8593747, "end": 15.7031246}]