[{"text": "But Eli said, I did not call you.", "start": 0.05, "end": 2.8365384999999996}, {"text": "Go back and lie down.", "start": 2.8365385, "end": 4.599359}, {"text": "So he did.", "start": 4.5993591, "end": 5.8173078}, {"text": "And the voice came again \u2014 Samuel \u2014 and again he ran to the old man, and again Eli sent him back.", "start": 5.8173079, "end": 14.2147441}, {"text": "It happened a third time.", "start": 14.2147441, "end": 16.1057698}]