[{"text": "And the Pharisee?", "start": 0.0, "end": 1.068}, {"text": "He is still standing there.", "start": 1.068, "end": 2.682}, {"text": "Still praying.", "start": 2.682, "end": 4.087}, {"text": "Still certain.", "start": 4.087, "end": 5.399}, {"text": "Still fine.", "start": 5.399, "end": 6.815}, {"text": "That is the saddest part of it.", "start": 6.815, "end": 9.067}, {"text": "The only thing keeping that man out was how sure he was that he was already in.", "start": 9.067, "end": 14.443}]