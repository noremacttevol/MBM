[{"text": "And the Pharisee?", "start": 0.05, "end": 1.3593749}, {"text": "He is still standing there.", "start": 1.3593749, "end": 3.1718748}, {"text": "Still praying.", "start": 3.1718749, "end": 4.4687498}, {"text": "Still certain.", "start": 4.4687499, "end": 5.765624799999999}, {"text": "Still fine.", "start": 5.7656249, "end": 7.046874799999999}, {"text": "That is the saddest part of it.", "start": 7.0468748, "end": 9.1249997}, {"text": "The only thing keeping that man out was how sure he was that he was already in.", "start": 9.1249998, "end": 14.3906247}]