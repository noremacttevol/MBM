[{"text": "And the Pharisee?", "start": 0.05, "end": 1.430921}, {"text": "He is still standing there.", "start": 1.430921, "end": 3.3388157}, {"text": "Still praying.", "start": 3.3388158, "end": 4.703947299999999}, {"text": "Still certain.", "start": 4.7039474, "end": 6.069078899999999}, {"text": "Still fine.", "start": 6.069079, "end": 7.4177632000000004}, {"text": "That is the saddest part of it.", "start": 7.4177632, "end": 9.6052632}, {"text": "The only thing keeping that man out was how sure he was that he was already in.", "start": 9.6052632, "end": 15.1480264}]