[{"text": "And the Pharisee?", "start": 0.0, "end": 1.091}, {"text": "He is still standing there.", "start": 1.091, "end": 2.357}, {"text": "Still praying.", "start": 2.357, "end": 3.808}, {"text": "Still certain.", "start": 3.808, "end": 5.027}, {"text": "Still fine.", "start": 5.027, "end": 6.316}, {"text": "That is the saddest part of it.", "start": 6.316, "end": 8.231}, {"text": "The only thing keeping that man out was how sure he was that he was already in.", "start": 8.231, "end": 13.932}]