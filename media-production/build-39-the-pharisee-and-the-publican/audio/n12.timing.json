[{"text": "And the Pharisee?", "start": 0.0, "end": 1.115}, {"text": "He is still standing there.", "start": 1.115, "end": 2.403}, {"text": "Still praying.", "start": 2.403, "end": 3.796}, {"text": "Still certain.", "start": 3.796, "end": 5.12}, {"text": "Still fine.", "start": 5.12, "end": 6.49}, {"text": "That is the saddest part of it.", "start": 6.49, "end": 8.8}, {"text": "The only thing keeping that man out was how sure he was that he was already in.", "start": 8.8, "end": 14.443}]