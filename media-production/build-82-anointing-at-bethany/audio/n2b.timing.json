[{"text": "Why has this been wasted?", "start": 0.05, "end": 1.8593749}, {"text": "they said.", "start": 1.8593749, "end": 2.8906248}, {"text": "And Mark adds one more line: they murmured against her.", "start": 2.8906249, "end": 7.296874799999999}, {"text": "They said it where she could hear it.", "start": 7.2968748, "end": 9.2812497}, {"text": "She does not answer them.", "start": 9.2812498, "end": 10.9062497}, {"text": "She never says a single word in this whole story.", "start": 10.9062498, "end": 14.2656247}]