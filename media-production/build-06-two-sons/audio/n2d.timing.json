[{"text": "So he got up.", "start": 0.05, "end": 1.2980769}, {"text": "And he went.", "start": 1.2980769, "end": 2.5320513}, {"text": "No announcement, no apology.", "start": 2.5320513, "end": 5.3525642}, {"text": "He went back to the vineyard, and he worked.", "start": 5.3525642, "end": 8.4134617}]