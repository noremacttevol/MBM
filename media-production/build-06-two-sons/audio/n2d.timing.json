[{"text": "So he got up.", "start": 0.05, "end": 1.2656249}, {"text": "And he went.", "start": 1.2656249, "end": 2.4687498}, {"text": "No announcement, no apology.", "start": 2.4687499, "end": 5.2187498}, {"text": "He went back to the vineyard, and he worked.", "start": 5.2187499, "end": 8.2031248}]