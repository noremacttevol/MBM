[{"text": "Out to the roads.", "start": 0.05, "end": 1.5384615000000001}, {"text": "Not the guest list.", "start": 1.5384615, "end": 3.1891024999999997}, {"text": "The roads.", "start": 3.1891026, "end": 4.4391026}, {"text": "Whoever happened to be out there.", "start": 4.4391027, "end": 6.602564300000001}, {"text": "The day laborers, the beggars, the people nobody ever puts on a list.", "start": 6.6025643, "end": 12.5801286}]