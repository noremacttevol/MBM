[{"text": "Out to the roads.", "start": 0.05, "end": 1.4999999}, {"text": "Not the guest list.", "start": 1.4999999, "end": 3.1093748}, {"text": "The roads.", "start": 3.1093749, "end": 4.3281248}, {"text": "Whoever happened to be out there.", "start": 4.3281249, "end": 6.437499799999999}, {"text": "The day laborers, the beggars, the people nobody ever puts on a list.", "start": 6.4374999, "end": 12.2656248}]