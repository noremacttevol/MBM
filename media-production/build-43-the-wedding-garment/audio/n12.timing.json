[{"text": "Friend.", "start": 0.05, "end": 0.9935897}, {"text": "That is what the king called him.", "start": 0.9935897, "end": 2.9166666}, {"text": "Not intruder.", "start": 2.9166667, "end": 4.2788462}, {"text": "Not thief.", "start": 4.2788463, "end": 5.5769231999999995}, {"text": "Friend, and a question, and every chance in the world to answer.", "start": 5.5769232, "end": 10.5128208}, {"text": "And the man had nothing to say.", "start": 10.5128208, "end": 12.7403849}]