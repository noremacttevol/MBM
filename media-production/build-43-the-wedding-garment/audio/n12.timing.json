[{"text": "Friend.", "start": 0.05, "end": 0.9687499}, {"text": "That is what the king called him.", "start": 0.9687499, "end": 2.8437498}, {"text": "Not intruder.", "start": 2.8437499, "end": 4.1718748}, {"text": "Not thief.", "start": 4.1718749, "end": 5.437499799999999}, {"text": "Friend, and a question, and every chance in the world to answer.", "start": 5.4374999, "end": 10.2499998}, {"text": "And the man had nothing to say.", "start": 10.2499998, "end": 12.4218747}]