[{"text": "Yes, God said.", "start": 0.05, "end": 1.6093749}, {"text": "For fifty, I will spare them all.", "start": 1.6093749, "end": 4.2968748}, {"text": "And you can almost feel Abraham's courage grow.", "start": 4.2968749, "end": 7.874999799999999}, {"text": "What about forty-five?", "start": 7.8749998, "end": 9.7031247}, {"text": "What about forty?", "start": 9.7031248, "end": 11.1562497}, {"text": "Thirty?", "start": 11.1562498, "end": 12.0624997}, {"text": "Each time, gently, the answer came back \u2014 yes.", "start": 12.0624998, "end": 16.6406247}, {"text": "Yes.", "start": 16.6406247, "end": 17.6562496}, {"text": "I will spare it.", "start": 17.6562497, "end": 19.0156246}]