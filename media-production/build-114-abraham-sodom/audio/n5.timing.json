[{"text": "Yes, God said.", "start": 0.0, "end": 1.161}, {"text": "And you can almost feel Abraham's courage grow.", "start": 1.161, "end": 4.191}, {"text": "What about forty-five?", "start": 4.191, "end": 6.014}, {"text": "What about forty?", "start": 6.014, "end": 7.43}, {"text": "Thirty?", "start": 7.43, "end": 8.313}, {"text": "Each time, gently, the answer came back \u2014 yes.", "start": 8.313, "end": 12.307}, {"text": "Yes.", "start": 12.307, "end": 12.887}, {"text": "I will spare it.", "start": 12.887, "end": 14.071}]