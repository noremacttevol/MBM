[{"text": "Yes, God said.", "start": 0.05, "end": 1.650641}, {"text": "For fifty, I will spare them all.", "start": 1.650641, "end": 4.4070513}, {"text": "And you can almost feel Abraham's courage grow.", "start": 4.4070514, "end": 8.0769233}, {"text": "What about forty-five?", "start": 8.0769233, "end": 9.9519233}, {"text": "What about forty?", "start": 9.9519234, "end": 11.442308}, {"text": "Thirty?", "start": 11.4423081, "end": 12.3717953}, {"text": "Each time, gently, the answer came back \u2014 yes.", "start": 12.3717953, "end": 17.0673082}, {"text": "Yes.", "start": 17.0673083, "end": 18.108975}, {"text": "I will spare it.", "start": 18.108975, "end": 19.5032058}]