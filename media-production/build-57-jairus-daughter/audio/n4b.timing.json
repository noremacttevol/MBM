[{"text": "Why all this noise and crying, he asked.", "start": 0.05, "end": 3.1718748999999997}, {"text": "The child is not dead.", "start": 3.1718749, "end": 4.9999998}, {"text": "She's asleep.", "start": 4.9999999, "end": 6.359374799999999}, {"text": "And they laughed at him, certain that she was gone.", "start": 6.3593749, "end": 9.7968748}]