[{"text": "So she came back.", "start": 0.05, "end": 1.5312499}, {"text": "And again.", "start": 1.5312499, "end": 2.6406248}, {"text": "And again.", "start": 2.6406249, "end": 3.7499998000000003}, {"text": "She would not stop.", "start": 3.7499999, "end": 5.2812498}, {"text": "Every day the same worn face at his door, the same steady voice asking for what was right.", "start": 5.2812499, "end": 12.1718747}]