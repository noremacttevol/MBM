[{"text": "So she came back.", "start": 0.0, "end": 1.324}, {"text": "And again.", "start": 1.324, "end": 2.554}, {"text": "And again.", "start": 2.554, "end": 3.715}, {"text": "She would not stop.", "start": 3.715, "end": 5.584}, {"text": "Every day the same worn face at his door, the same steady voice asking for what was right.", "start": 5.584, "end": 11.935}]