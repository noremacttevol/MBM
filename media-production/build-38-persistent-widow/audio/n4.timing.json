[{"text": "So she came back.", "start": 0.0, "end": 1.057}, {"text": "And again.", "start": 1.057, "end": 2.206}, {"text": "And again.", "start": 2.206, "end": 3.111}, {"text": "She would not stop.", "start": 3.111, "end": 4.203}, {"text": "Every day the same worn face at his door, the same steady voice asking for what was right.", "start": 4.203, "end": 10.031}]