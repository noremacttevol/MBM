[{"text": "So she came back.", "start": 0.05, "end": 1.5705128000000002}, {"text": "And again.", "start": 1.5705128, "end": 2.7083332999999996}, {"text": "And again.", "start": 2.7083334, "end": 3.8461539}, {"text": "She would not stop.", "start": 3.8461539, "end": 5.4166667}, {"text": "Every day the same worn face at his door, the same steady voice asking for what was right.", "start": 5.4166668, "end": 12.483974700000001}]