[{"text": "So she came back.", "start": 0.0, "end": 1.196}, {"text": "And again.", "start": 1.196, "end": 2.276}, {"text": "And again.", "start": 2.276, "end": 3.332}, {"text": "She would not stop.", "start": 3.332, "end": 4.783}, {"text": "Every day the same worn face at his door, the same steady voice asking for what was right.", "start": 4.783, "end": 11.006}]