[{"text": "Where are you.", "start": 0.0, "end": 1.05}, {"text": "Not, what have you done.", "start": 1.05, "end": 2.849}, {"text": "Not, how dare you.", "start": 2.849, "end": 4.198}, {"text": "Where are you \u2014 the cry of a Father looking for a child who is hiding.", "start": 4.198, "end": 9.446}, {"text": "He knew exactly where they were.", "start": 9.446, "end": 11.845}, {"text": "He asked so they would come out.", "start": 11.845, "end": 14.244}, {"text": "And, trembling, the man answered.", "start": 14.244, "end": 16.718}]