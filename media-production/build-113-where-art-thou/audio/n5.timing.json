[{"text": "Where are you.", "start": 0.05, "end": 1.0781249}, {"text": "Not, what have you done.", "start": 1.0781249, "end": 3.1093748000000003}, {"text": "Not, how dare you.", "start": 3.1093749, "end": 5.0624998}, {"text": "Where are you \u2014 the cry of a Father looking for a child who is hiding.", "start": 5.0624999, "end": 10.1718748}, {"text": "He knew exactly where they were.", "start": 10.1718748, "end": 12.4374997}, {"text": "He asked so they would come out.", "start": 12.4374998, "end": 14.5156247}, {"text": "And, trembling, the man answered.", "start": 14.5156247, "end": 17.5468746}]