[{"text": "Where are you.", "start": 0.0, "end": 1.045}, {"text": "Not, what have you done.", "start": 1.045, "end": 2.995}, {"text": "Not, how dare you.", "start": 2.995, "end": 4.923}, {"text": "Where are you \u2014 the cry of a Father looking for a child who is hiding.", "start": 4.923, "end": 9.985}, {"text": "He knew exactly where they were.", "start": 9.985, "end": 12.167}, {"text": "He asked so they would come out.", "start": 12.167, "end": 14.211}, {"text": "And, trembling, the man answered.", "start": 14.211, "end": 16.672}]