[{"text": "He did not send back an argument.", "start": 0.05, "end": 2.3281248999999997}, {"text": "He sent back a scene.", "start": 2.3281249, "end": 4.0156248}, {"text": "Go and tell John what you see happening \u2014 right here, right now.", "start": 4.0156249, "end": 8.6249998}, {"text": "The blind seeing.", "start": 8.6249998, "end": 10.1562497}, {"text": "The broken mended.", "start": 10.1562498, "end": 11.6718747}, {"text": "The poorest people being treated like they matter.", "start": 11.6718748, "end": 14.8437497}, {"text": "This is what I am doing.", "start": 14.8437497, "end": 16.4843746}]