[{"text": "He did not send back an argument.", "start": 0.05, "end": 2.3878206}, {"text": "He sent back a scene.", "start": 2.3878206, "end": 4.1185898}, {"text": "Go and tell John what you see happening \u2014 right here, right now.", "start": 4.1185898, "end": 8.846153999999999}, {"text": "The blind seeing.", "start": 8.8461541, "end": 10.4166669}, {"text": "The broken mended.", "start": 10.416667, "end": 11.9711542}, {"text": "The poorest people being treated like they matter.", "start": 11.9711542, "end": 15.2243594}, {"text": "This is what I am doing.", "start": 15.2243595, "end": 16.9070518}]