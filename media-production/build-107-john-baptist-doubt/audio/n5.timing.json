[{"text": "Not overthrowing an empire.", "start": 0.05, "end": 2.3878206}, {"text": "Not breaking open a prison.", "start": 2.3878206, "end": 4.4551283}, {"text": "But healing, one by one, the people everyone else stepped over.", "start": 4.4551283, "end": 10.0641028}, {"text": "That was the answer to give a doubting man.", "start": 10.0641029, "end": 12.964744}, {"text": "Look at the love.", "start": 12.964744, "end": 14.2948722}, {"text": "Look at what it is actually doing.", "start": 14.2948723, "end": 16.5064108}]