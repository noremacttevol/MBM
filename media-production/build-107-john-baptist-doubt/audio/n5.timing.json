[{"text": "Not overthrowing an empire.", "start": 0.05, "end": 2.3281248999999997}, {"text": "Not breaking open a prison.", "start": 2.3281249, "end": 4.3437498}, {"text": "But healing, one by one, the people everyone else stepped over.", "start": 4.3437499, "end": 9.8124998}, {"text": "That was the answer to give a doubting man.", "start": 9.8124998, "end": 12.6406247}, {"text": "Look at the love.", "start": 12.6406248, "end": 13.9374997}, {"text": "Look at what it is actually doing.", "start": 13.9374997, "end": 16.0937496}]