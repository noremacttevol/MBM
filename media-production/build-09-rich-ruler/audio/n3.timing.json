[{"text": "You're missing one thing.", "start": 0.05, "end": 1.5781249}, {"text": "Not one more rule.", "start": 1.5781249, "end": 3.0781248}, {"text": "One thing standing between you and God.", "start": 3.0781249, "end": 6.2656248}, {"text": "Sell what you have.", "start": 6.2656249, "end": 7.671874799999999}, {"text": "Give it to the people who have nothing.", "start": 7.6718748, "end": 9.9687497}, {"text": "And then \u2014 come, follow me.", "start": 9.9687498, "end": 12.7968747}]