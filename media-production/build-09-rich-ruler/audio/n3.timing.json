[{"text": "You're missing one thing.", "start": 0.0, "end": 1.335}, {"text": "Not one more rule.", "start": 1.335, "end": 3.007}, {"text": "One thing standing between you and God.", "start": 3.007, "end": 5.526}, {"text": "Sell what you have.", "start": 5.526, "end": 7.047}, {"text": "Give it to the people who have nothing.", "start": 7.047, "end": 9.091}, {"text": "And then \u2014 come, follow me.", "start": 9.091, "end": 12.121}]