[{"text": "You're missing one thing.", "start": 0.0, "end": 1.219}, {"text": "Not one more rule.", "start": 1.219, "end": 2.914}, {"text": "One thing standing between you and God.", "start": 2.914, "end": 5.608}, {"text": "Sell what you have.", "start": 5.608, "end": 7.187}, {"text": "Give it to the people who have nothing.", "start": 7.187, "end": 9.451}, {"text": "And then \u2014 come, follow me.", "start": 9.451, "end": 12.121}]