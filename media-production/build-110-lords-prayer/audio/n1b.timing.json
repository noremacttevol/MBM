[{"text": "Teach us how to pray.", "start": 0.05, "end": 1.5781249}, {"text": "They expected, maybe, a technique.", "start": 1.5781249, "end": 4.8593748}, {"text": "A ritual.", "start": 4.8593749, "end": 6.015624799999999}, {"text": "Instead, Jesus gave them a family word.", "start": 6.0156249, "end": 9.4687498}]