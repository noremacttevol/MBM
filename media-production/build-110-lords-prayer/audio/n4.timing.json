[{"text": "Keep me safe.", "start": 0.05, "end": 1.4102564}, {"text": "Leed me away from what would harm me.", "start": 1.4102564, "end": 3.8942308}, {"text": "And it ends where it began \u2014 with him: the kingdom, the power, the glory, all his, for ever.", "start": 3.8942309, "end": 13.0608979}, {"text": "Short.", "start": 13.0608979, "end": 14.0224363}, {"text": "Honest.", "start": 14.0224364, "end": 15.0801287}, {"text": "Nothing showy.", "start": 15.0801287, "end": 16.3942313}]