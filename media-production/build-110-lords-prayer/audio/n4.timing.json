[{"text": "Keep me safe.", "start": 0.05, "end": 1.3749999}, {"text": "Leed me away from what would harm me.", "start": 1.3749999, "end": 3.7968748000000003}, {"text": "And it ends where it began \u2014 with him: the kingdom, the power, the glory, all his, forever.", "start": 3.7968749, "end": 12.5624997}, {"text": "Short.", "start": 12.5624998, "end": 13.4999997}, {"text": "Honest.", "start": 13.4999997, "end": 14.5312496}, {"text": "Nothing showy.", "start": 14.5312497, "end": 15.8124996}]