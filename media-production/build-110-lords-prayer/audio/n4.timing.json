[{"text": "Keep me safe.", "start": 0.0, "end": 0.871}, {"text": "Lead me away from what would harm me.", "start": 0.871, "end": 3.042}, {"text": "And it ends where it began \u2014 with him: Short.", "start": 3.042, "end": 6.885}, {"text": "Honest.", "start": 6.885, "end": 7.93}, {"text": "Nothing showy.", "start": 7.93, "end": 9.242}]