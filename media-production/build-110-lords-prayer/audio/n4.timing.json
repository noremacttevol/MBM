[{"text": "Keep me safe.", "start": 0.05, "end": 1.4102564}, {"text": "Lead me away from what would harm me.", "start": 1.4102564, "end": 3.8301282}, {"text": "And it ends where it began \u2014 with him: the kingdom, the power, the glory, all his, for ever.", "start": 3.8301283, "end": 12.9967953}, {"text": "Short.", "start": 12.9967953, "end": 13.9583337}, {"text": "Honest.", "start": 13.9583338, "end": 15.0160261}, {"text": "Nothing showy.", "start": 15.0160261, "end": 16.3301287}]