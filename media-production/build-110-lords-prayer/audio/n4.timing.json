[{"text": "Keep me safe.", "start": 0.0, "end": 1.126}, {"text": "Lead me away from what would harm me.", "start": 1.126, "end": 3.088}, {"text": "And it ends where it began \u2014 with him: Short.", "start": 3.088, "end": 7.372}, {"text": "Honest.", "start": 7.372, "end": 8.487}, {"text": "Nothing showy.", "start": 8.487, "end": 10.124}]