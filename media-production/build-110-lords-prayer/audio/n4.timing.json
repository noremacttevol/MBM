[{"text": "Keep me safe.", "start": 0.0, "end": 1.039}, {"text": "Lead me away from what would harm me.", "start": 1.039, "end": 3.997}, {"text": "And it ends where it began \u2014 with him: Short.", "start": 3.997, "end": 7.595}, {"text": "Honest.", "start": 7.595, "end": 8.154}, {"text": "Nothing showy.", "start": 8.154, "end": 9.273}]