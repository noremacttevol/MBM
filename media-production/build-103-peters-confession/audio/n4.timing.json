[{"text": "And there it was.", "start": 0.0, "end": 1.149}, {"text": "Not what have you heard.", "start": 1.149, "end": 2.798}, {"text": "Not what is the crowd saying.", "start": 2.798, "end": 4.992}, {"text": "But you \u2014 who do you say that I am?", "start": 4.992, "end": 8.44}, {"text": "The question stopped them cold.", "start": 8.44, "end": 11.285}, {"text": "This one you cannot borrow from anybody else.", "start": 11.285, "end": 14.629}]