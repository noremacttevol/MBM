[{"text": "And there it was.", "start": 0.05, "end": 1.3301282}, {"text": "Not what have you heard.", "start": 1.3301282, "end": 2.8685897000000002}, {"text": "Not what is the crowd saying.", "start": 2.8685898, "end": 4.8878205999999995}, {"text": "But you \u2014 who do you say that I am?", "start": 4.8878206, "end": 7.4839745}, {"text": "The question stopped them cold.", "start": 7.4839746, "end": 9.8076926}, {"text": "This one you cannot borrow from anybody else.", "start": 9.8076926, "end": 13.4134619}]