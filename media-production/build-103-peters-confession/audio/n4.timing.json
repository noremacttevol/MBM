[{"text": "And there it was.", "start": 0.05, "end": 1.2968749}, {"text": "Not what have you heard.", "start": 1.2968749, "end": 2.7968748}, {"text": "Not what is the crowd saying.", "start": 2.7968749, "end": 4.7656248}, {"text": "But you \u2014 who do you say that I am?", "start": 4.7656249, "end": 7.296874799999999}, {"text": "The question stopped them cold.", "start": 7.2968748, "end": 9.5624997}, {"text": "This one you cannot borrow from anybody else.", "start": 9.5624998, "end": 13.0781247}]