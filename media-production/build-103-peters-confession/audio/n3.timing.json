[{"text": "Some say Elijah come back.", "start": 0.0, "end": 1.602}, {"text": "Others, Jeremiah, or one of the old prophets.", "start": 1.602, "end": 4.632}, {"text": "All respectful.", "start": 4.632, "end": 6.095}, {"text": "All safe.", "start": 6.095, "end": 6.92}, {"text": "All second-hand \u2014 what other people thought.", "start": 6.92, "end": 10.217}]