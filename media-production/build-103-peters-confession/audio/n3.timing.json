[{"text": "Some say you are John the Baptist, they told him.", "start": 0.05, "end": 3.3333334}, {"text": "Some say Elijah come back.", "start": 3.3333334, "end": 5.4647437}, {"text": "Others, Jeremiah, or one of the old prophets.", "start": 5.4647437, "end": 9.6474361}, {"text": "All respectful.", "start": 9.6474362, "end": 11.1698721}, {"text": "All safe.", "start": 11.1698722, "end": 12.4198722}, {"text": "All second-hand \u2014 what other people thought.", "start": 12.4198722, "end": 15.4967953}]