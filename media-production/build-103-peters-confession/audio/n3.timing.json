[{"text": "Some say you are John the Baptist, they told him.", "start": 0.05, "end": 3.2499998999999997}, {"text": "Some say Elijah come back.", "start": 3.2499999, "end": 5.3281248}, {"text": "Others, Jeremiah, or one of the old prophets.", "start": 5.3281249, "end": 9.4062498}, {"text": "All respectful.", "start": 9.4062498, "end": 10.8906247}, {"text": "All safe.", "start": 10.8906248, "end": 12.1093747}, {"text": "All second-hand \u2014 what other people thought.", "start": 12.1093748, "end": 15.1093747}]