[{"text": "Some say Elijah come back.", "start": 0.0, "end": 1.66}, {"text": "Others, Jeremiah, or one of the old prophets.", "start": 1.66, "end": 5.027}, {"text": "All respectful.", "start": 5.027, "end": 6.502}, {"text": "All safe.", "start": 6.502, "end": 7.442}, {"text": "All second-hand \u2014 what other people thought.", "start": 7.442, "end": 10.681}]