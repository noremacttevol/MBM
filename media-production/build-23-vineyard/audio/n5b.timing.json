[{"text": "Why have you stood here all day doing nothing, he asked them.", "start": 0.05, "end": 3.9218748999999997}, {"text": "Because no one hired us, they said.", "start": 3.9218749, "end": 6.7812498}, {"text": "Not lazy.", "start": 6.7812498, "end": 7.9843747}, {"text": "Not hiding.", "start": 7.9843748, "end": 9.1406247}, {"text": "Nobody had ever picked them.", "start": 9.1406248, "end": 11.0312497}]