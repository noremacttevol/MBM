[{"text": "I am the vine, he said.", "start": 0.0, "end": 1.277}, {"text": "You are the branches.", "start": 1.277, "end": 2.821}, {"text": "Not visitors.", "start": 2.821, "end": 3.936}, {"text": "Not hired hands.", "start": 3.936, "end": 5.166}, {"text": "Branches \u2014 part of the same living thing.", "start": 5.166, "end": 8.452}]