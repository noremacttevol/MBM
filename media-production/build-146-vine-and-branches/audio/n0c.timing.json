[{"text": "I am the vine, he said.", "start": 0.0, "end": 1.713}, {"text": "You are the branches.", "start": 1.713, "end": 3.277}, {"text": "Not visitors.", "start": 3.277, "end": 4.245}, {"text": "Not hired hands.", "start": 4.245, "end": 5.436}, {"text": "Branches \u2014 part of the same living thing.", "start": 5.436, "end": 8.49}]