[{"text": "I am the vine, he said.", "start": 0.05, "end": 1.9374999}, {"text": "You are the branches.", "start": 1.9374999, "end": 3.5624998}, {"text": "Not visitors.", "start": 3.5624999, "end": 4.9999998}, {"text": "Not hired hands.", "start": 4.9999999, "end": 6.593749799999999}, {"text": "Branches \u2014 part of the same living thing.", "start": 6.5937499, "end": 9.6874998}]