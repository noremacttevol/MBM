[{"text": "And Naaman was furious.", "start": 0.05, "end": 2.0468748999999997}, {"text": "He had expected something great \u2014 a mighty ceremony worthy of a mighty man.", "start": 2.0468749, "end": 8.0624998}, {"text": "Wash in the Jordan?", "start": 8.0624998, "end": 9.5468747}, {"text": "It was too plain.", "start": 9.5468748, "end": 11.0312497}, {"text": "Too simple.", "start": 11.0312498, "end": 12.2031247}, {"text": "He turned and rode away in a rage.", "start": 12.2031248, "end": 15.2499997}]