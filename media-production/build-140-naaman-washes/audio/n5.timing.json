[{"text": "The instruction wasn't beneath him.", "start": 0.05, "end": 2.4843748999999997}, {"text": "It was the way back.", "start": 2.4843749, "end": 4.0624998}, {"text": "If you've been away, the way back may look almost too simple \u2014 pray again, read again, come back again.", "start": 4.0624999, "end": 12.7499997}, {"text": "Do the simple thing.", "start": 12.7499998, "end": 14.2656247}]