[{"text": "Simon, son of Jonas, do you love me.", "start": 0.05, "end": 3.4999998999999997}, {"text": "Not, how could you.", "start": 3.4999999, "end": 5.4062498}, {"text": "Not, prove it.", "start": 5.4062499, "end": 6.796874799999999}, {"text": "Not one word thrown back at him about the denial.", "start": 6.7968748, "end": 10.2656247}, {"text": "Only: do you love me.", "start": 10.2656248, "end": 12.2656247}]