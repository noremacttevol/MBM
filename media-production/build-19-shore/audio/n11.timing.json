[{"text": "Simon, son of Jonas, do you love me.", "start": 0.05, "end": 3.5897436999999996}, {"text": "Not, how could you.", "start": 3.5897437, "end": 5.5448719}, {"text": "Not, prove it.", "start": 5.5448719, "end": 6.971154}, {"text": "Not one word thrown back at him about the denial.", "start": 6.9711541, "end": 10.5288465}, {"text": "Only: do you love me.", "start": 10.5288465, "end": 12.5801286}]