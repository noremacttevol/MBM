[{"text": "Have you caught anything, he called.", "start": 0.05, "end": 2.2968748999999997}, {"text": "And they had to say it out loud to a stranger \u2014 no.", "start": 2.2968749, "end": 5.8593748}, {"text": "Nothing.", "start": 5.8593749, "end": 6.781249799999999}, {"text": "All night, nothing.", "start": 6.7812498, "end": 8.4687497}]