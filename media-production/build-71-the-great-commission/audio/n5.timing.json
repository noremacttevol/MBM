[{"text": "Teach them not just to hear it but to live it, everything he had shown them.", "start": 0.0, "end": 3.866}, {"text": "And then the promise that holds the whole thing up.", "start": 3.866, "end": 6.618}, {"text": "I am with you always.", "start": 6.618, "end": 8.406}, {"text": "Not until it gets hard.", "start": 8.406, "end": 10.147}, {"text": "Not until you fail.", "start": 10.147, "end": 11.796}, {"text": "Always, to the very end.", "start": 11.796, "end": 13.746}]