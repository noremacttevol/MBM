[{"text": "Teach them not just to hear it but to live it, everything he had shown them.", "start": 0.0, "end": 4.307}, {"text": "And then the promise that holds the whole thing up.", "start": 4.307, "end": 7.082}, {"text": "I am with you always.", "start": 7.082, "end": 8.87}, {"text": "Not until it gets hard.", "start": 8.87, "end": 10.519}, {"text": "Not until you fail.", "start": 10.519, "end": 12.132}, {"text": "Always, to the very end.", "start": 12.132, "end": 14.35}]