[{"text": "Teach them not just to hear it but to live it, everything he had shown them.", "start": 0.0, "end": 3.982}, {"text": "And then the promise that holds the whole thing up.", "start": 3.982, "end": 6.664}, {"text": "I am with you always.", "start": 6.664, "end": 8.406}, {"text": "Not until it gets hard.", "start": 8.406, "end": 10.159}, {"text": "Not until you fail.", "start": 10.159, "end": 11.912}, {"text": "Always, to the very end.", "start": 11.912, "end": 13.978}]