[{"text": "Teach them not just to hear it but to live it, everything he had shown them.", "start": 0.05, "end": 5.1562499}, {"text": "And then the promise that holds the whole thing up.", "start": 5.1562499, "end": 8.1718748}, {"text": "I am with you always.", "start": 8.1718748, "end": 9.8749997}, {"text": "Not until it gets hard.", "start": 9.8749998, "end": 11.6718747}, {"text": "Not until you fail.", "start": 11.6718748, "end": 13.3124997}, {"text": "Always, to the very end.", "start": 13.3124998, "end": 15.6874997}]