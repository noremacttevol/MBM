[{"text": "But while he was still far off, his father saw him and ran.", "start": 0.05, "end": 4.4687499}, {"text": "No lecture.", "start": 4.4687499, "end": 5.734374799999999}, {"text": "No waiting for the apology.", "start": 5.7343749, "end": 7.796874799999999}, {"text": "He threw his arms around him.", "start": 7.7968748, "end": 9.8124997}]