[{"text": "Everyone on that hillside knew that old arithmetic.", "start": 0.0, "end": 2.577}, {"text": "Keep your guard up against the ones who don't.", "start": 2.577, "end": 4.981}, {"text": "It felt fair.", "start": 4.981, "end": 6.072}, {"text": "It felt safe.", "start": 6.072, "end": 7.338}, {"text": "And then Jesus said this.", "start": 7.338, "end": 9.427}]