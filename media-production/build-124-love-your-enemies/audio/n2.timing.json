[{"text": "Everyone on that hillside knew that old arithmetic.", "start": 0.0, "end": 2.287}, {"text": "Keep your guard up against the ones who don't.", "start": 2.287, "end": 4.551}, {"text": "It felt fair.", "start": 4.551, "end": 5.817}, {"text": "It felt safe.", "start": 5.817, "end": 6.989}, {"text": "And then Jesus said this.", "start": 6.989, "end": 8.916}]