[{"text": "Everyone on that hillside knew that old arithmetic.", "start": 0.05, "end": 3.8437498999999997}, {"text": "Love the people who love you.", "start": 3.8437499, "end": 5.8124998}, {"text": "Keep your guard up against the ones who don't.", "start": 5.8124999, "end": 8.8906248}, {"text": "It felt fair.", "start": 8.8906248, "end": 10.2968747}, {"text": "It felt safe.", "start": 10.2968748, "end": 11.7499997}, {"text": "And then Jesus said this.", "start": 11.7499998, "end": 13.7968747}]