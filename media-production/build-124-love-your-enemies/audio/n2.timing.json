[{"text": "Everyone on that hillside knew the old arithmetic.", "start": 0.05, "end": 3.9262821}, {"text": "Love the people who love you.", "start": 3.9262821, "end": 5.9455129}, {"text": "Keep your guard up against the ones who don't.", "start": 5.945513, "end": 9.102564300000001}, {"text": "It felt fair.", "start": 9.1025644, "end": 10.544872100000001}, {"text": "It felt safe.", "start": 10.5448721, "end": 12.0352567}, {"text": "And then Jesus said this.", "start": 12.0352568, "end": 14.1346158}]