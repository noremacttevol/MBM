[{"text": "Knock \u2014 and keep knocking \u2014 on a door you cannot yet see behind.", "start": 0.0, "end": 4.725}, {"text": "And the promise is that the door does open.", "start": 4.725, "end": 7.674}, {"text": "Not maybe.", "start": 7.674, "end": 8.963}, {"text": "Not for the specially worthy.", "start": 8.963, "end": 11.018}, {"text": "Every one who asks, receives.", "start": 11.018, "end": 13.793}]