[{"text": "Knock \u2014 and keep knocking \u2014 on a door you cannot yet see behind.", "start": 0.0, "end": 4.493}, {"text": "And the promise is that the door does open.", "start": 4.493, "end": 6.954}, {"text": "Not maybe.", "start": 6.954, "end": 8.394}, {"text": "Not for the specially worthy.", "start": 8.394, "end": 10.321}, {"text": "Every one who asks, receives.", "start": 10.321, "end": 12.957}]