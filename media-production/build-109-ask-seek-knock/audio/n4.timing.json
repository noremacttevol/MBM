[{"text": "Knock \u2014 and keep knocking \u2014 on a door you cannot yet see behind.", "start": 0.05, "end": 5.3365386}, {"text": "And the promise is that the door does open.", "start": 5.3365386, "end": 8.3173079}, {"text": "Not maybe.", "start": 8.3173079, "end": 9.487179699999999}, {"text": "Not for the specially worthy.", "start": 9.4871798, "end": 11.6826927}, {"text": "Every one who asks, receives.", "start": 11.6826927, "end": 14.6314107}]