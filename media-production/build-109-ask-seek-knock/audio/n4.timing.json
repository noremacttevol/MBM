[{"text": "Knock \u2014 and keep knocking \u2014 on a door you cannot yet see behind.", "start": 0.0, "end": 4.748}, {"text": "And the promise is that the door does open.", "start": 4.748, "end": 7.938}, {"text": "Not maybe.", "start": 7.938, "end": 8.68}, {"text": "Not for the specially worthy.", "start": 8.68, "end": 10.831}, {"text": "Every one who asks, receives.", "start": 10.831, "end": 12.983}]