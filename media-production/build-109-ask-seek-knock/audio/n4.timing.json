[{"text": "Knock \u2014 and keep knocking \u2014 on a door you cannot yet see behind.", "start": 0.05, "end": 5.2031249}, {"text": "And the promise is that the door does open.", "start": 5.2031249, "end": 8.1093748}, {"text": "Not maybe.", "start": 8.1093748, "end": 9.2499997}, {"text": "Not for the specially worthy.", "start": 9.2499998, "end": 11.3906247}, {"text": "Every one who asks, receives.", "start": 11.3906248, "end": 14.2656247}]