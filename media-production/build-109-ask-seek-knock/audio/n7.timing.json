[{"text": "So the invitation is just this: ask.", "start": 0.05, "end": 3.5468748999999997}, {"text": "Not perfectly.", "start": 3.5468749, "end": 4.9218748}, {"text": "Not impressively.", "start": 4.9218749, "end": 6.406249799999999}, {"text": "Simply, honestly, like a child.", "start": 6.4062499, "end": 9.2499998}, {"text": "The Father is not reluctant.", "start": 9.2499998, "end": 11.4374997}, {"text": "He is leaning in, glad to hear your voice.", "start": 11.4374998, "end": 14.9062497}]