[{"text": "So the invitation is just this: ask.", "start": 0.0, "end": 2.855}, {"text": "Not perfectly.", "start": 2.855, "end": 3.965}, {"text": "Not impressively.", "start": 3.965, "end": 5.313}, {"text": "Simply, honestly, like a child.", "start": 5.313, "end": 7.771}, {"text": "The Father is not reluctant.", "start": 7.771, "end": 9.992}, {"text": "He is leaning in, glad to hear your voice.", "start": 9.992, "end": 13.322}]