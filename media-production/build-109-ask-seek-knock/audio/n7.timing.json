[{"text": "So the invitation is just this: ask.", "start": 0.05, "end": 3.7335526}, {"text": "Not perfectly.", "start": 3.7335526, "end": 5.180921}, {"text": "Not impressively.", "start": 5.1809211, "end": 6.7434211}, {"text": "Simply, honestly, like a child.", "start": 6.7434211, "end": 9.7368421}, {"text": "The Father is not reluctant.", "start": 9.7368422, "end": 12.0394738}, {"text": "He is leaning in, glad to hear your voice.", "start": 12.0394738, "end": 15.690789599999999}]