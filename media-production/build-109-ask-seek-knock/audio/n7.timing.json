[{"text": "So the invitation is just this: ask.", "start": 0.0, "end": 2.961}, {"text": "Not perfectly.", "start": 2.961, "end": 4.017}, {"text": "Not impressively.", "start": 4.017, "end": 5.12}, {"text": "Simply, honestly, like a child.", "start": 5.12, "end": 8.394}, {"text": "The Father is not reluctant.", "start": 8.394, "end": 10.414}, {"text": "He is leaning in, glad to hear your voice.", "start": 10.414, "end": 13.514}]