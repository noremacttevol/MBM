[{"text": "So the invitation is just this: ask.", "start": 0.0, "end": 3.03}, {"text": "Not perfectly.", "start": 3.03, "end": 4.319}, {"text": "Not impressively.", "start": 4.319, "end": 5.898}, {"text": "Simply, honestly, like a child.", "start": 5.898, "end": 8.51}, {"text": "The Father is not reluctant.", "start": 8.51, "end": 10.472}, {"text": "He is leaning in, glad to hear your voice.", "start": 10.472, "end": 13.282}]