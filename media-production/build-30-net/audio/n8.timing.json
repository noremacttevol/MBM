[{"text": "There is a real end, and a real sorting.", "start": 0.05, "end": 3.4218748999999997}, {"text": "But notice whose job it is.", "start": 3.4218749, "end": 5.4218748}, {"text": "The angels do it.", "start": 5.4218749, "end": 6.921874799999999}, {"text": "God does it.", "start": 6.9218748, "end": 8.1093747}, {"text": "At the very end.", "start": 8.1093748, "end": 9.5781247}, {"text": "It was never handed to us to do.", "start": 9.5781248, "end": 12.0312497}]