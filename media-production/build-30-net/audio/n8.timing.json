[{"text": "There is a real end, and a real sorting.", "start": 0.05, "end": 3.5551947999999998}, {"text": "But notice whose job it is.", "start": 3.5551948, "end": 5.6331169}, {"text": "The angels do it.", "start": 5.633117, "end": 7.1915585}, {"text": "God does it.", "start": 7.1915586, "end": 8.4253248}, {"text": "At the very end.", "start": 8.4253248, "end": 9.9512988}, {"text": "It was never handed to us to do.", "start": 9.9512989, "end": 12.500000199999999}]