[{"text": "There is a real end, and a real sorting.", "start": 0.0, "end": 2.276}, {"text": "But notice whose job it is.", "start": 2.276, "end": 4.284}, {"text": "The angels do it.", "start": 4.284, "end": 5.654}, {"text": "God does it.", "start": 5.654, "end": 6.699}, {"text": "At the very end.", "start": 6.699, "end": 8.057}, {"text": "It was never handed to us to do.", "start": 8.057, "end": 10.403}]