[{"text": "There is a real end, and a real sorting.", "start": 0.0, "end": 2.554}, {"text": "But notice whose job it is.", "start": 2.554, "end": 4.725}, {"text": "The angels do it.", "start": 4.725, "end": 6.072}, {"text": "God does it.", "start": 6.072, "end": 7.349}, {"text": "At the very end.", "start": 7.349, "end": 8.789}, {"text": "It was never handed to us to do.", "start": 8.789, "end": 10.635}]