[{"text": "There is a real end, and a real sorting.", "start": 0.0, "end": 2.345}, {"text": "But notice whose job it is.", "start": 2.345, "end": 4.365}, {"text": "The angels do it.", "start": 4.365, "end": 5.875}, {"text": "God does it.", "start": 5.875, "end": 6.885}, {"text": "At the very end.", "start": 6.885, "end": 8.464}, {"text": "It was never handed to us to do.", "start": 8.464, "end": 10.635}]