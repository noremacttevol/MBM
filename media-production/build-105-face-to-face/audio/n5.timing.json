[{"text": "Face to face.", "start": 0.05, "end": 1.4531249}, {"text": "As a man speaks with his friend.", "start": 1.4531249, "end": 3.7968748000000003}, {"text": "Not a master barking at a servant.", "start": 3.7968749, "end": 6.3124998}, {"text": "Not a king across a vast throne room \u2014 easy, honest, close.", "start": 6.3124999, "end": 12.6406248}, {"text": "God wanted Moses.", "start": 12.6406248, "end": 14.3749997}, {"text": "Not just his obedience.", "start": 14.3749997, "end": 16.4687496}, {"text": "His friendship.", "start": 16.4687497, "end": 17.7187496}]