[{"text": "Not a master barking at a servant.", "start": 0.0, "end": 1.916}, {"text": "Not a king across a vast throne room \u2014 easy, honest, close.", "start": 1.916, "end": 6.908}, {"text": "God wanted Moses.", "start": 6.908, "end": 8.812}, {"text": "Not just his obedience.", "start": 8.812, "end": 10.484}, {"text": "His friendship.", "start": 10.484, "end": 11.889}]