[{"text": "I will go with you myself, and I will give you rest.", "start": 0.05, "end": 3.8437498999999997}, {"text": "Not send someone ahead.", "start": 3.8437499, "end": 5.6562498}, {"text": "Not watch from somewhere far off.", "start": 5.6562499, "end": 8.0781248}, {"text": "Go with you.", "start": 8.0781248, "end": 9.1249997}]