[{"text": "Second picture, higher stakes.", "start": 0.05, "end": 2.5781248999999997}, {"text": "And look at what he asks about the king.", "start": 2.5781249, "end": 5.0156248}, {"text": "Not whether he is brave.", "start": 5.0156249, "end": 6.937499799999999}, {"text": "Whether he can count.", "start": 6.9374998, "end": 8.5312497}, {"text": "An army of ten thousand against an army of twenty thousand is arithmetic, not courage.", "start": 8.5312498, "end": 15.578124599999999}]