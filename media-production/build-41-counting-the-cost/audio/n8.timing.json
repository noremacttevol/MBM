[{"text": "Second picture, higher stakes.", "start": 0.05, "end": 2.6442308}, {"text": "And look at what he asks about the king.", "start": 2.6442308, "end": 5.1442308}, {"text": "Not whether he is brave.", "start": 5.1442309, "end": 7.1153848}, {"text": "Whether he can count.", "start": 7.1153848, "end": 8.7500002}, {"text": "An army of ten thousand against an army of twenty thousand is arithmetic, not courage.", "start": 8.7500003, "end": 15.977564600000001}]