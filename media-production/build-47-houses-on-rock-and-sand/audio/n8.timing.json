[{"text": "And here is the thing.", "start": 0.05, "end": 1.5156249}, {"text": "His house looked fine.", "start": 1.5156249, "end": 3.2031248}, {"text": "It went up faster, it stood there in the sunshine, and you could not have told the two houses apart.", "start": 3.2031249, "end": 10.6718747}, {"text": "Not until the weather turned.", "start": 10.6718748, "end": 12.6093747}]