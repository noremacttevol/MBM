[{"text": "And here is the thing.", "start": 0.05, "end": 1.5544872}, {"text": "His house looked fine.", "start": 1.5544872, "end": 3.2852563999999997}, {"text": "It went up faster, it stood there in the sunshine, and you could not have told the two houses apart.", "start": 3.2852565, "end": 10.9455131}, {"text": "Not until the weather turned.", "start": 10.9455132, "end": 12.9326927}]