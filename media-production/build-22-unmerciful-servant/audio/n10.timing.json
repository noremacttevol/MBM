[{"text": "He grabbed the man by the throat and started to choke him.", "start": 0.05, "end": 3.7968748999999997}, {"text": "Pay me what you owe me!", "start": 3.7968749, "end": 5.4531248}, {"text": "he snarled.", "start": 5.4531249, "end": 6.703124799999999}, {"text": "Pay me now!", "start": 6.7031249, "end": 7.828124799999999}]