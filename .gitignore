# ─────────────────────────────────────────────────────────────────────────────
# SECRETS / ENVIRONMENT — never commit. The Anthropic API key lives in these.
# ─────────────────────────────────────────────────────────────────────────────
.env
*.env
.env.*
**/.env
**/*.env

# ─────────────────────────────────────────────────────────────────────────────
# BUILD ARTIFACTS — the Expo web export bundles EXPO_PUBLIC_* values (including
# the API key) straight into the JS. Never commit it.
# ─────────────────────────────────────────────────────────────────────────────
dist/
**/dist/
build/
**/build/
web-build/
*.tsbuildinfo

# ─────────────────────────────────────────────────────────────────────────────
# DEPENDENCIES
# ─────────────────────────────────────────────────────────────────────────────
node_modules/
**/node_modules/
.pnp
.pnp.js

# ─────────────────────────────────────────────────────────────────────────────
# EXPO / REACT NATIVE
# ─────────────────────────────────────────────────────────────────────────────
.expo/
**/.expo/
.expo-shared/
*.orig.*
*.jks
*.p8
*.p12
*.key
*.mobileprovision

# ─────────────────────────────────────────────────────────────────────────────
# PYTHON
# ─────────────────────────────────────────────────────────────────────────────
__pycache__/
**/__pycache__/
*.py[cod]
*$py.class
.venv/
venv/
env/
.Python
*.egg-info/

# ─────────────────────────────────────────────────────────────────────────────
# DATABASES — may contain user/test data; regenerated from seed code.
# ─────────────────────────────────────────────────────────────────────────────
*.db
*.sqlite
*.sqlite3
*.backup.gz
*-backup.gz

# ─────────────────────────────────────────────────────────────────────────────
# BUILT APP BINARIES & UPLOAD CREDENTIALS — never commit. These are large build
# outputs (Android/iOS packages) or signing/upload material that must stay local.
# ─────────────────────────────────────────────────────────────────────────────
*.apk
*.aab
*.ipa
*.pem

# ─────────────────────────────────────────────────────────────────────────────
# LOGS
# ─────────────────────────────────────────────────────────────────────────────
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# ─────────────────────────────────────────────────────────────────────────────
# OS / EDITOR
# ─────────────────────────────────────────────────────────────────────────────
.DS_Store
Thumbs.db
*.swp
*.swo

# ─────────────────────────────────────────────────────────────────────────────
# AGENT / SESSION SCRATCH
# ─────────────────────────────────────────────────────────────────────────────
.auto-memory/

# Embedded legacy git repo — excluded to avoid a broken submodule pointer
archive/legacy/MBM-mobile/
web-preview/

# ─────────────────────────────────────────────────────────────────────────────
# FIREBASE — local deploy/hosting cache, regenerated by the CLI. Not source.
# ─────────────────────────────────────────────────────────────────────────────
.firebase/
media-production/build-05-bent-woman/segs/
media-production/build-07-peter-water/segs/

# assembly intermediates (rebuildable, too large for GitHub)
media-production/*/segs/
media-production/bin/
media-production/build-*/build_run.log
# QC scratch is rebuildable and enormous. The old rule only covered qc/frames/,
# so build-11-storm's qc/frames-clipA, qc/final, qc/rework and friends slipped
# through: ship-fixes.sh's `git add -A -- "$dir/"` swept 4,529 files / 12 GB into
# one commit on 2026-07-22, and every push after it hung and failed — #11, #171,
# #173, #25 and #33 all sat unshipped behind it. Ignore the whole folder.
media-production/build-*/qc/

# Feed 2.0 streaming copies — duplicates of the tracked media-production finals,
# staged here only for Firebase Hosting deploy (regenerate by copying finals in).
site/story-videos/

# Hosting artifacts staged for deploy — 2.8 GB of duplicate cuts. A single
# `git add -A site/` swept these in on 2026-08-02 and the push died with HTTP 500,
# which is the same failure that cost this repo days in July. They are copies of
# tracked finals; never commit them. (site/fixed/SERVE-LOCAL.txt stays tracked.)
site/fixed/*.mp4
site/*.mp4
!site/Milk-Before-Meat-Explainer.mp4

# SPEAKER-LAW working files — audition audio and the generated page are large
# and machine-local; the law, the survey and the stills work-order are tracked.
media-production/SPEAKER-LAW/auditions/
media-production/SPEAKER-LAW/audition.html
media-production/build-*/*.pre-speaker

# NEVER commit the ElevenLabs API key — repo is public, providers auto-revoke leaked keys
elevenlabs*KEY*.txt
media-production/elevenlabs*KEY*.txt

# archive/dupe-dirs holds superseded duplicate build folders kept only as local
# reference — their audio was never tracked and should not clutter git status.
archive/dupe-dirs/**/*.mp3
