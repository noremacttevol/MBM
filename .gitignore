# ─────────────────────────────────────────────────────────────────────────────
# SECRETS / ENVIRONMENT — never commit. The Anthropic API key lives in these.
# ─────────────────────────────────────────────────────────────────────────────
.env
*.env
.env.*
**/.env
**/*.env

# ─────────────────────────────────────────────────────────────────────────────
# BUILD ARTIFACTS — the Expo web export bundles EXPO_PUBLIC_* values (including
# the API key) straight into the JS. Never commit it.
# ─────────────────────────────────────────────────────────────────────────────
dist/
**/dist/
build/
**/build/
web-build/
*.tsbuildinfo

# ─────────────────────────────────────────────────────────────────────────────
# DEPENDENCIES
# ─────────────────────────────────────────────────────────────────────────────
node_modules/
**/node_modules/
.pnp
.pnp.js

# ─────────────────────────────────────────────────────────────────────────────
# EXPO / REACT NATIVE
# ─────────────────────────────────────────────────────────────────────────────
.expo/
**/.expo/
.expo-shared/
*.orig.*
*.jks
*.p8
*.p12
*.key
*.mobileprovision

# ─────────────────────────────────────────────────────────────────────────────
# PYTHON
# ─────────────────────────────────────────────────────────────────────────────
__pycache__/
**/__pycache__/
*.py[cod]
*$py.class
.venv/
venv/
env/
.Python
*.egg-info/

# ─────────────────────────────────────────────────────────────────────────────
# DATABASES — may contain user/test data; regenerated from seed code.
# ─────────────────────────────────────────────────────────────────────────────
*.db
*.sqlite
*.sqlite3
*.backup.gz
*-backup.gz

# ─────────────────────────────────────────────────────────────────────────────
# BUILT APP BINARIES & UPLOAD CREDENTIALS — never commit. These are large build
# outputs (Android/iOS packages) or signing/upload material that must stay local.
# ─────────────────────────────────────────────────────────────────────────────
*.apk
*.aab
*.ipa
*.pem

# ─────────────────────────────────────────────────────────────────────────────
# LOGS
# ─────────────────────────────────────────────────────────────────────────────
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# ─────────────────────────────────────────────────────────────────────────────
# OS / EDITOR
# ─────────────────────────────────────────────────────────────────────────────
.DS_Store
Thumbs.db
*.swp
*.swo

# ─────────────────────────────────────────────────────────────────────────────
# AGENT / SESSION SCRATCH
# ─────────────────────────────────────────────────────────────────────────────
.auto-memory/

# Embedded legacy git repo — excluded to avoid a broken submodule pointer
archive/legacy/MBM-mobile/
web-preview/

# ─────────────────────────────────────────────────────────────────────────────
# FIREBASE — local deploy/hosting cache, regenerated by the CLI. Not source.
# ─────────────────────────────────────────────────────────────────────────────
.firebase/
media-production/build-05-bent-woman/segs/
media-production/build-07-peter-water/segs/

# assembly intermediates (rebuildable, too large for GitHub)
media-production/*/segs/
media-production/bin/
media-production/build-*/build_run.log
media-production/build-*/qc/frames/

# Feed 2.0 streaming copies — duplicates of the tracked media-production finals,
# staged here only for Firebase Hosting deploy (regenerate by copying finals in).
site/story-videos/
