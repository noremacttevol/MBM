[{"text": "I am the vine, he said.", "start": 0.0, "end": 1.312}, {"text": "You are the branches.", "start": 1.312, "end": 2.705}, {"text": "Not visitors.", "start": 2.705, "end": 3.82}, {"text": "Not hired hands.", "start": 3.82, "end": 5.224}, {"text": "Branches \u2014 part of the same living thing.", "start": 5.224, "end": 8.684}]