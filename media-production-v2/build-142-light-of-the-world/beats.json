   "audio_dur": 4.493,
   "spoken_dur": 4.085,
   "seg_dur": 5.365,
   "timing": [
    {
     "text": "Later, as he met a man who had never seen a face or a sunrise, he said it again.",
     "start": 0.0,
     "end": 4.458
    }
   ]
  },
  {
   "seg": "j2",
