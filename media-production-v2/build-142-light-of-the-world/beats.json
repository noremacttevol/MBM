   "audio_dur": 6.504,
   "spoken_dur": 6.114,
   "seg_dur": 8.294,
   "timing": [
    {
     "text": "I am the light of the world: he that followeth me shall not walk in darkness, but shall have the light of life.",
     "start": 0.0,
     "end": 6.455
    }
   ]
  },
  {
   "seg": "n1",
   "v1_still": "s3-a-light-that-walks-with-you.jpeg",
