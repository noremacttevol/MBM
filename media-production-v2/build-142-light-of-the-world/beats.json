   "speaker": "narrator",
   "text": "-20%",
   "seg_start": 17.558,
   "audio_start": 17.838,
   "spoken_end": 28.314,
   "seg_end": 29.314,
   "audio_dur": 10.893,
   "spoken_dur": 10.476,
   "seg_dur": 11.756,
   "timing": [
    {
     "text": "Not a lamp that burns out.",
     "start": 0.0,
     "end": 1.533
    },
    {
     "text": "A light that walks with you, so you're never feeling your way blind.",
     "start": 1.533,
     "end": 6.049
    },
    {
     "text": "It does not pretend the night is harmless.",
     "start": 6.049,
     "end": 8.545
    },
    {
     "text": "It gives you someone to follow through it.",
     "start": 8.545,
     "end": 10.867
    }
   ]
  },
  {
