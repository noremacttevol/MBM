[{"text": "And there it was.", "start": 0.0, "end": 1.103}, {"text": "Not what have you heard.", "start": 1.103, "end": 2.635}, {"text": "Not what is the crowd saying.", "start": 2.635, "end": 4.818}, {"text": "But you \u2014 who do you say that I am?", "start": 4.818, "end": 7.744}, {"text": "The question stopped them cold.", "start": 7.744, "end": 9.857}, {"text": "This one you cannot borrow from anybody else.", "start": 9.857, "end": 12.91}]