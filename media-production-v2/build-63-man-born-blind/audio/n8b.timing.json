[{"text": "Who is he, sir?", "start": 0.0, "end": 0.998}, {"text": "Tell me, so I can believe in him.", "start": 0.998, "end": 3.135}, {"text": "He is not stalling.", "start": 3.135, "end": 4.714}, {"text": "He is asking for a name so he can give himself to it.", "start": 4.714, "end": 7.906}, {"text": "And Jesus said:", "start": 8.255, "end": 9.567}]