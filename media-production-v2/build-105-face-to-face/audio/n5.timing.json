[{"text": "Not a master barking at a servant.", "start": 0.0, "end": 2.743}, {"text": "Not a king across a vast throne room \u2014 easy, honest, close.", "start": 2.743, "end": 7.502}, {"text": "God wanted Moses.", "start": 7.502, "end": 8.873}, {"text": "Not just his obedience.", "start": 8.873, "end": 10.728}, {"text": "His friendship.", "start": 10.728, "end": 11.938}]