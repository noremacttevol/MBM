[{"text": "Yes, God said.", "start": 0.0, "end": 1.207}, {"text": "And you can almost feel Abraham's courage grow.", "start": 1.207, "end": 4.435}, {"text": "What about forty-five?", "start": 4.435, "end": 6.2}, {"text": "What about forty?", "start": 6.2, "end": 7.686}, {"text": "Thirty?", "start": 7.686, "end": 8.766}, {"text": "Each time, gently, the answer came back \u2014 yes.", "start": 8.766, "end": 13.235}, {"text": "Yes.", "start": 13.235, "end": 13.886}, {"text": "I will spare it.", "start": 13.886, "end": 15.047}]