[{"text": "Notice what did not happen.", "start": 0.0, "end": 1.382}, {"text": "She did not push through a crowd.", "start": 1.382, "end": 3.402}, {"text": "She did not call out to him.", "start": 3.402, "end": 5.259}, {"text": "She did not ask.", "start": 5.259, "end": 6.571}, {"text": "He called her first.", "start": 6.571, "end": 7.976}, {"text": "Before she said one word, he had already decided.", "start": 7.976, "end": 11.238}]